# Web (injected at Next.js build time)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional internal server-side URL for App Router data fetches
INTERNAL_API_URL=http://localhost:4000

# Docker Compose default profile
COMPOSE_PROFILES=groq

# API
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
POKEAPI_REQUEST_TIMEOUT_MS=8000
POKEAPI_MAX_RETRIES=2
POKEAPI_RETRY_BASE_DELAY_MS=250
POKEAPI_INDEX_CONCURRENCY=4

# Optional AI (external Ollama service running on host)
AI_PROVIDER=groq
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2:0.5b
GROQ_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.1-8b-instant
# Keep this secret and never expose it as NEXT_PUBLIC_*
GROQ_API_KEY=
AI_MAX_TOKENS=80
AI_NUM_CTX=1024
AI_REQUEST_TIMEOUT_MS=90000

# Optional API cache warm-up behavior
# initial: preload first list page only
# full: preload all list pages
CACHE_WARMUP_ENABLED=true
CACHE_WARMUP_MODE=initial
CACHE_WARMUP_PAGE_SIZE=60
CACHE_WARMUP_CONCURRENCY=2
