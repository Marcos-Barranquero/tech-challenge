# Web (injected at Next.js build time)
NEXT_PUBLIC_API_URL=http://localhost:4000

# API
PORT=4000
HOST=0.0.0.0

# Optional AI (external Ollama service running on host)
AI_PROVIDER=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2:0.5b
AI_MAX_TOKENS=80
AI_NUM_CTX=1024
AI_REQUEST_TIMEOUT_MS=90000

# Optional API cache warm-up behavior
# initial: preload first list page only
# full: preload all list pages
CACHE_WARMUP_MODE=initial
CACHE_WARMUP_PAGE_SIZE=60
