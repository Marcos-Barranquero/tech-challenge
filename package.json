{
  "name": "tech-challenge",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "playwright test -c apps/web/playwright.config.ts --grep-invert \"@a11y|@perf\"",
    "test:e2e:headed": "playwright test -c apps/web/playwright.config.ts --headed",
    "test:perf:smoke": "playwright test -c apps/web/playwright.config.ts --grep @perf",
    "test:a11y": "playwright test -c apps/web/playwright.config.ts --grep @a11y",
    "slides:dev": "pnpm --filter @tech-challenge/presentation dev",
    "slides:build": "pnpm --filter @tech-challenge/presentation build",
    "slides:html": "pnpm --filter @tech-challenge/presentation build:html",
    "slides:pdf": "pnpm --filter @tech-challenge/presentation build:pdf",
    "slides:pptx": "pnpm --filter @tech-challenge/presentation build:pptx"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^4.0.18",
    "turbo": "^2.5.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
